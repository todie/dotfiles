#!/usr/bin/env bash
# claude-pid — print the PID of the Claude Code session that owns the caller.
#
# Inside a hook, skill, or Bash tool call, `$$` is only the transient shell that
# Claude spawned — not the session itself. coord/mesh identity (the `claude_pid`
# coord registers) keys off the *claude* process, so scripts that need "who am I"
# must resolve the owning session. This walks the process ancestry from the
# caller up to the nearest `claude` process and prints its PID.
#
# Usage:
#   claude-pid                 # nearest claude ancestor of this process (the owning session)
#   claude-pid --top           # OUTERMOST claude ancestor (root session, if nested)
#   claude-pid --chain         # print the full claude ancestry, nearest-first (debug)
#   claude-pid --quiet         # no stderr if none found; just exit 1
#   claude-pid <PID>           # resolve the owning session of an arbitrary PID
#
# Exit: 0 + pid on stdout if found; 1 if no claude ancestor (not in a session).
set -euo pipefail

top=0 chain=0 quiet=0 start=""
for a in "$@"; do
  case "$a" in
    --top)    top=1 ;;
    --chain)  chain=1 ;;
    --quiet)  quiet=1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "claude-pid: unknown flag '$a'" >&2; exit 2 ;;
    *)  start="$a" ;;
  esac
done
start="${start:-$$}"

# PPid from /proc/<pid>/status — robust against comm strings containing spaces/parens
# (which would break `awk '{print $4}'` on /proc/<pid>/stat).
ppid_of() { awk '/^PPid:/{print $2; exit}' "/proc/$1/status" 2>/dev/null; }

# A process is the claude CLI if its comm is exactly "claude", or its argv[0]
# basename is "claude" (handles the node-exec'd entrypoint). Exact match so this
# script ("claude-pid") and MCP helpers never self-match.
is_claude() {
  local pid="$1" comm cmd0
  comm=$(cat "/proc/$pid/comm" 2>/dev/null) || return 1
  [ "$comm" = "claude" ] && return 0
  cmd0=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | head -1)
  [ -n "${cmd0:-}" ] && [ "$(basename -- "$cmd0")" = "claude" ] && return 0
  return 1
}

# Walk ancestry, collecting every claude ancestor nearest-first.
found=()
pid="$start"
while [ -n "${pid:-}" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
  is_claude "$pid" && found+=("$pid")
  pid=$(ppid_of "$pid")
done

if [ "${#found[@]}" -eq 0 ]; then
  (( quiet )) || echo "claude-pid: no claude ancestor of pid $start — not inside a Claude Code session" >&2
  exit 1
fi

if (( chain )); then
  printf '%s\n' "${found[@]}"
elif (( top )); then
  printf '%s\n' "${found[-1]}"
else
  printf '%s\n' "${found[0]}"
fi
