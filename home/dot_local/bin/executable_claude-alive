#!/usr/bin/env bash
# claude-alive — is a Claude Code session pid still live?
#
# Sibling to claude-pid. Verifies a pid is alive (kill -0) AND still a claude
# process (comm=claude). The identity guard matters because a `coord peers`
# entry can show a fresh-looking heartbeat for a DEAD pid, and a bare kill -0
# can be fooled by PID reuse — so a stale registration or a recycled pid reads
# as dead here, not alive. Default target: this process's owning session
# (resolved via claude-pid).
#
# Usage:
#   claude-alive                # is my own session alive? (resolves via claude-pid)
#   claude-alive <PID>          # is that claude session pid alive AND still claude?
#   claude-alive --loose <PID>  # alive check only — plain kill -0, any process
#   claude-alive --quiet ...    # no output; exit status only
#
# Exit: 0 = alive (and a claude session, unless --loose); 1 = dead / reused /
#       not-a-session; 2 = usage error.
set -euo pipefail

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

loose=0 quiet=0 pid=""
for a in "$@"; do
  case "$a" in
    --loose|--any) loose=1 ;;
    --quiet|-q)    quiet=1 ;;
    -h|--help)     usage; exit 0 ;;
    -*) echo "claude-alive: unknown flag '$a'" >&2; exit 2 ;;
    *)  pid="$a" ;;
  esac
done

say() { (( quiet )) || echo "$@"; }
err() { (( quiet )) || echo "$@" >&2; }

# Liveness without the kill -0 EPERM ambiguity: kill -0 returns non-zero for
# BOTH "no such process" (ESRCH = dead) and "not permitted" (EPERM = alive but
# unsignalable, e.g. pid 1). Fall back to /proc to tell them apart.
is_alive() {
  kill -0 "$1" 2>/dev/null && return 0   # signalable      -> alive
  [ -e "/proc/$1" ] && return 0          # exists, EPERM   -> still alive
  return 1                               # ESRCH           -> dead
}

# Default to the caller's owning session.
if [ -z "$pid" ]; then
  pid=$(claude-pid --quiet) || {
    err "claude-alive: not inside a Claude Code session and no PID given"; exit 1; }
fi
[[ "$pid" =~ ^[0-9]+$ ]] || { err "claude-alive: invalid pid '$pid'"; exit 2; }

# Alive at all?
if ! is_alive "$pid"; then
  say "dead"; exit 1
fi

# Identity guard (skipped with --loose): is it still a claude process, or a
# reused pid now belonging to something else?
if (( ! loose )); then
  comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
  cmd0=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | head -1 || true)
  if [ "$comm" != "claude" ] && [ "$(basename -- "${cmd0:-/x}")" != "claude" ]; then
    err "dead (pid $pid alive but not a claude session: comm=${comm:-?})"
    exit 1
  fi
fi

say "alive"
exit 0
