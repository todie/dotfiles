#!/usr/bin/env bash
# theme — list or switch the active starship theme.
#
# Usage:
#   theme              # show current
#   theme list         # list available themes
#   theme set <name>   # switch to <name>
#   theme next         # cycle to next
#   theme prev         # cycle to previous
#   theme random       # roll the dice
#
# How it works: the active starship config at ~/.config/starship.toml is
# generated by concatenating two files from the dotfiles repo:
#
#   ~/projects/dotfiles/starship/base.toml          (layout — segments + format)
#   ~/projects/dotfiles/starship/themes/<name>.toml (palette only)
#
# The currently active theme name is stored in ~/.config/starship.theme so
# `theme show` can read it without parsing TOML.

set -euo pipefail

DOTFILES_STARSHIP="{{ .chezmoi.sourceDir }}/starship"
BASE="$DOTFILES_STARSHIP/base.toml"
THEMES_DIR="$DOTFILES_STARSHIP/themes"
ACTIVE_FILE="$HOME/.config/starship.toml"
THEME_STATE="$HOME/.config/starship.theme"

BOLD="$(tput bold 2>/dev/null || printf '')"
NC="$(tput sgr0 2>/dev/null || printf '')"
PINK="$(tput setaf 13 2>/dev/null || printf '')"
CYAN="$(tput setaf 14 2>/dev/null || printf '')"
DIM="$(tput setaf 8 2>/dev/null || printf '')"

themes() {
    find "$THEMES_DIR" -maxdepth 1 -type f -name '*.toml' -printf '%f\n' \
        | sed 's/\.toml$//' | sort
}

current() {
    if [[ -f "$THEME_STATE" ]]; then
        cat "$THEME_STATE"
    else
        echo "neon-dreams"
    fi
}

# Parse `key = "#hex"` palette lines from a theme TOML into the _pal assoc array.
# Every theme defines the same semantic keys (neon_pink, neon_void, fg_on_pink…),
# so downstream consumers (tmux, fzf) read by role regardless of the palette.
_parse_palette() {
    unset _pal; declare -gA _pal
    local line
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*([a-z_]+)[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\" ]] \
            && _pal[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
    done < "$1"
}

# Emit a tmux color fragment sourced by ~/.tmux.conf (see its theme block).
_emit_tmux_theme() {
    local out="$HOME/.config/tmux/theme.conf"; mkdir -p "$(dirname "$out")"
    local void=${_pal[neon_void]} panel=${_pal[neon_panel]} pink=${_pal[neon_pink]} \
          cyan=${_pal[neon_cyan]} purple=${_pal[neon_purple]} yellow=${_pal[neon_yellow]} \
          green=${_pal[neon_green]} dim=${_pal[neon_dim]} text=${_pal[neon_text]} \
          fgpink=${_pal[fg_on_pink]} fgcyan=${_pal[fg_on_cyan]} fgpurple=${_pal[fg_on_purple]} \
          fgyellow=${_pal[fg_on_yellow]} red=${_pal[neon_red]}
    cat > "$out" <<EOF
# AUTO-GENERATED by 'theme set $name' — DO NOT EDIT (edit starship/themes/<name>.toml).
# Palette as user-options: reference in any custom format string (e.g. a local
# ~/.tmux.conf.d/*.conf status-right) as #[fg=#{@t_pink},bg=#{@t_void}] so it
# follows the theme. They re-expand on every status redraw, so switching themes
# recolors custom segments live — no re-source needed.
set -g @t_void "$void"
set -g @t_panel "$panel"
set -g @t_pink "$pink"
set -g @t_cyan "$cyan"
set -g @t_purple "$purple"
set -g @t_yellow "$yellow"
set -g @t_green "$green"
set -g @t_red "$red"
set -g @t_dim "$dim"
set -g @t_text "$text"
set -g @t_fg_on_pink "$fgpink"
set -g @t_fg_on_cyan "$fgcyan"
set -g @t_fg_on_purple "$fgpurple"
set -g @t_fg_on_yellow "$fgyellow"
set -g status-style "bg=$void,fg=$text"
set -g pane-border-style "fg=$dim"
set -g pane-active-border-style "fg=$pink"
set -g message-style "bg=$pink,fg=$fgpink,bold"
set -g message-command-style "bg=$purple,fg=$fgpurple,bold"
set -g mode-style "bg=$purple,fg=$fgpurple,bold"
set -g display-panes-active-colour "$pink"
set -g display-panes-colour "$cyan"
# Airy/minimalist status bar — foreground color on the bare bg, no filled
# capsules or powerline separators (matches the starship prompt). Session name
# left; git branch + time right. tmux-claude-state and the date segment dropped.
set -g status-left "#[fg=$pink,bold] #S #[default]"
setw -g window-status-format         "#[fg=$dim] #I:#W#{?window_zoomed_flag, ⊕,}#{?window_last_flag, ‹,} "
setw -g window-status-current-format "#[fg=$cyan,bold] #I:#W#{?window_zoomed_flag, ⊕,} "
setw -g window-status-activity-style "fg=$yellow,blink"
setw -g window-status-bell-style     "fg=$pink,blink,bold"
set -g status-right "#[fg=$dim]#(tmux-git-branch '#{pane_current_path}') #[fg=$pink]%H:%M "
set -g clock-mode-colour "$pink"
set -g copy-mode-match-style "bg=$dim,fg=$pink"
set -g copy-mode-current-match-style "bg=$pink,fg=$fgpink"
EOF
}

# Emit a zsh color fragment sourced by env.zsh (fzf) and plugins.zsh (fzf-tab, hss).
_emit_zsh_theme() {
    local out="$HOME/.config/zsh/theme.zsh"; mkdir -p "$(dirname "$out")"
    local void=${_pal[neon_void]} panel=${_pal[neon_panel]} pink=${_pal[neon_pink]} \
          cyan=${_pal[neon_cyan]} purple=${_pal[neon_purple]} green=${_pal[neon_green]} \
          dim=${_pal[neon_dim]} text=${_pal[neon_text]} red=${_pal[neon_red]}
    cat > "$out" <<EOF
# AUTO-GENERATED by 'theme set $name' — DO NOT EDIT (edit starship/themes/<name>.toml).
# fzf core color spec (consumed in FZF_DEFAULT_OPTS, env.zsh)
export THEME_FZF_COLORS="fg:$text,bg:-1,hl:$pink,fg+:$text,bg+:$panel,hl+:$pink,info:$cyan,prompt:$pink,pointer:$pink,marker:$green,spinner:$purple,header:$dim,border:$dim,label:$text"
# fzf-tab flags (plugins.zsh)
export THEME_FZFTAB_COLORS="fg:$text,bg:-1,hl:$pink,fg+:$text,bg+:$panel,hl+:$pink,border:$dim,pointer:$pink,marker:$green,spinner:$purple,header:$dim"
# history-substring-search highlight (plugins.zsh)
export THEME_HSS_FOUND="bg=$pink,fg=$void,bold"
export THEME_HSS_NOTFOUND="bg=$red,fg=#ffffff"
EOF
}

# Emit a k9s skin from the palette → ~/.config/k9s/skins/dotfiles.yaml, and point
# k9s at it (k9s.ui.skin: dotfiles) once. Schema mirrors the shipped v0.50 skins
# (key set ⊆ skins/nord.yaml) so it passes k9s's SkinSchema validation. bgColor
# stays `default` (inherit terminal bg) to match the airy/transparent direction
# the rest of the env uses (fzf bg:-1). k9s does NOT live-reload skins — a running
# k9s must be restarted to pick up a theme switch.
_emit_k9s_theme() {
    command -v k9s >/dev/null 2>&1 || return 0
    local skindir="$HOME/.config/k9s/skins"; mkdir -p "$skindir"
    local pink=${_pal[neon_pink]} cyan=${_pal[neon_cyan]} purple=${_pal[neon_purple]} \
          yellow=${_pal[neon_yellow]} green=${_pal[neon_green]} red=${_pal[neon_red]} \
          panel=${_pal[neon_panel]} dim=${_pal[neon_dim]} text=${_pal[neon_text]} \
          fgpink=${_pal[fg_on_pink]}
    cat > "$skindir/dotfiles.yaml" <<EOF
# AUTO-GENERATED by 'theme set $name' — DO NOT EDIT (edit starship/themes/<name>.toml).
k9s:
  body:
    fgColor: "$text"
    bgColor: default
    logoColor: "$pink"
  prompt:
    fgColor: "$text"
    bgColor: default
    suggestColor: "$dim"
  info:
    fgColor: "$cyan"
    sectionColor: "$text"
  dialog:
    fgColor: "$text"
    bgColor: default
    buttonFgColor: "$text"
    buttonBgColor: "$purple"
    buttonFocusFgColor: "$fgpink"
    buttonFocusBgColor: "$pink"
    labelFgColor: "$yellow"
    fieldFgColor: "$text"
  frame:
    border:
      fgColor: "$dim"
      focusColor: "$pink"
    menu:
      fgColor: "$text"
      keyColor: "$cyan"
      numKeyColor: "$yellow"
    crumbs:
      fgColor: "$text"
      bgColor: "$panel"
      activeColor: "$pink"
    status:
      newColor: "$cyan"
      modifyColor: "$purple"
      addColor: "$green"
      errorColor: "$red"
      highlightColor: "$yellow"
      killColor: "$dim"
      completedColor: "$dim"
    title:
      fgColor: "$pink"
      bgColor: default
      highlightColor: "$yellow"
      counterColor: "$purple"
      filterColor: "$cyan"
  views:
    charts:
      bgColor: default
      defaultDialColors:
        - "$green"
        - "$red"
      defaultChartColors:
        - "$cyan"
        - "$purple"
    table:
      fgColor: "$text"
      bgColor: default
      header:
        fgColor: "$cyan"
        bgColor: default
        sorterColor: "$yellow"
    xray:
      fgColor: "$text"
      bgColor: default
      cursorColor: "$pink"
      graphicColor: "$purple"
      showIcons: false
    yaml:
      keyColor: "$cyan"
      colonColor: "$dim"
      valueColor: "$text"
    logs:
      fgColor: "$text"
      bgColor: default
      indicator:
        fgColor: "$fgpink"
        bgColor: "$pink"
        toggleOnColor: "$green"
        toggleOffColor: "$dim"
    help:
      fgColor: "$text"
      bgColor: default
      indicator:
        fgColor: "$pink"
EOF
    # Point k9s at the skin ONCE (k9s.ui.skin). k9s owns config.yaml and rewrites
    # it on exit but preserves the skin field; the skin FILE tracks the palette
    # and regenerates every switch, so the pointer only needs setting once.
    # Back up before the first edit (mirrors the WT emitter); skip if already set.
    local cfg="$HOME/.config/k9s/config.yaml"
    [[ -f "$cfg" ]] || return 0
    grep -qE '^[[:space:]]+skin:[[:space:]]*dotfiles[[:space:]]*$' "$cfg" && return 0
    [[ -f "$cfg.dotfiles-bak" ]] || cp "$cfg" "$cfg.dotfiles-bak"
    if grep -qE '^[[:space:]]+skin:' "$cfg"; then
        sed -i -E 's|^([[:space:]]+skin:).*|\1 dotfiles|' "$cfg"
    else
        sed -i -E 's|^([[:space:]]+ui:[[:space:]]*)$|\1\n    skin: dotfiles|' "$cfg"
    fi
}

# OPT-IN: mirror the palette into Windows Terminal's settings.json (WSL only).
# Off by default — it writes a *Windows app* config, so you enable it explicitly
# with DOTFILES_THEME_WT=1 (e.g. in ~/.zshrc-${USER}). Guardrails: backs up
# settings.json once (.dotfiles-bak), writes atomically, and validates the JSON
# before replacing — a failed merge leaves the original untouched. Maintains one
# reused scheme named "dotfiles" and points the active profile ($WT_PROFILE_ID,
# else profiles.defaults) at it. WT auto-reloads on save → recolors live.
_emit_windows_terminal() {
    [[ "${DOTFILES_THEME_WT:-0}" == "1" ]] || return 0
    command -v jq >/dev/null 2>&1 || { printf "${DIM}WT theming needs jq — skipped${NC}\n" >&2; return 0; }
    local wt cand
    for cand in /mnt/c/Users/*/AppData/Local/Packages/Microsoft.WindowsTerminal*_8wekyb3d8bbwe/LocalState/settings.json; do
        [[ -f "$cand" ]] && { wt="$cand"; break; }
    done
    [[ -n "${wt:-}" ]] || return 0           # not on WSL / WT not installed
    [[ -f "$wt.dotfiles-bak" ]] || cp "$wt" "$wt.dotfiles-bak"
    local scheme
    scheme=$(jq -n --arg name dotfiles \
        --arg bg "${_pal[neon_void]}"  --arg fg "${_pal[neon_text]}" \
        --arg cur "${_pal[neon_pink]}" --arg sel "${_pal[neon_dim]}" \
        --arg red "${_pal[neon_red]}"  --arg grn "${_pal[neon_green]}" \
        --arg yel "${_pal[neon_yellow]}" --arg blu "${_pal[neon_cyan]}" \
        --arg pur "${_pal[neon_purple]}" --arg blk "${_pal[neon_panel]}" \
        --arg dim "${_pal[neon_dim]}" '{
            name:$name, background:$bg, foreground:$fg, cursorColor:$cur, selectionBackground:$sel,
            black:$blk, red:$red, green:$grn, yellow:$yel, blue:$blu, purple:$pur, cyan:$blu, white:$fg,
            brightBlack:$dim, brightRed:$red, brightGreen:$grn, brightYellow:$yel, brightBlue:$blu,
            brightPurple:$pur, brightCyan:$blu, brightWhite:$fg }') || return 0
    jq --argjson s "$scheme" --arg id "${WT_PROFILE_ID:-}" '
        # upsert the scheme (tolerate a missing .schemes key)
        .schemes = (((.schemes // []) | map(select(.name != "dotfiles"))) + [$s])
        # point the active profile at it — handle BOTH profiles shapes:
        # modern object { defaults, list:[…] } and legacy array […].
        | if (.profiles | type) == "object" then
            if ($id != "" and any((.profiles.list // [])[]; .guid == $id))
            then .profiles.list |= map(if .guid == $id then .colorScheme = "dotfiles" else . end)
            else .profiles.defaults.colorScheme = "dotfiles" end   # auto-vivifies defaults
          elif (.profiles | type) == "array" then
            if ($id != "" and any(.profiles[]; .guid == $id))
            then .profiles |= map(if .guid == $id then .colorScheme = "dotfiles" else . end)
            else . end                                             # array form has no defaults; leave as-is
          else . end
    ' "$wt" > "$wt.tmp" 2>/dev/null \
        && jq -e . "$wt.tmp" >/dev/null 2>&1 \
        && mv "$wt.tmp" "$wt" \
        && printf "${DIM}Windows Terminal scheme updated${NC}\n" \
        || { rm -f "$wt.tmp"; printf "${PINK}WT update failed — settings.json left untouched${NC}\n" >&2; }
}

set_theme() {
    local name="$1"
    local target="$THEMES_DIR/${name}.toml"
    if [[ ! -f "$target" ]]; then
        printf "${PINK}theme not found:${NC} %s\n" "$name" >&2
        printf "available:\n" >&2
        themes | sed 's/^/  /' >&2
        return 1
    fi
    if [[ ! -f "$BASE" ]]; then
        printf "${PINK}missing base config:${NC} %s\n" "$BASE" >&2
        return 1
    fi
    mkdir -p "$(dirname "$ACTIVE_FILE")"
    {
        echo "# AUTO-GENERATED by 'theme set $name' on $(date -Iseconds)"
        echo "# DO NOT EDIT — regenerated whenever you switch themes."
        echo "# Edit base.toml or themes/<name>.toml in ~/projects/dotfiles/starship/."
        echo
        # Base first (owns layout + root-level keys). Theme second (appends
        # only the [palettes.neon_dreams] block — isolated from root keys).
        cat "$BASE"
        echo
        cat "$target"
    } > "$ACTIVE_FILE.tmp"
    mv "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
    echo "$name" > "$THEME_STATE"

    # Drive tmux + fzf from the same palette so the whole environment matches.
    _parse_palette "$target"
    _emit_tmux_theme
    _emit_zsh_theme
    _emit_k9s_theme          # writes ~/.config/k9s/skins/dotfiles.yaml; no-op if k9s absent
    _emit_windows_terminal   # opt-in (DOTFILES_THEME_WT=1); no-op otherwise
    # Live-reload tmux if a server is running (no-op otherwise).
    if command -v tmux >/dev/null 2>&1 && tmux info &>/dev/null; then
        tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
    fi

    printf "${CYAN}▲${NC} active theme: ${BOLD}${PINK}%s${NC}\n" "$name"
    printf "${DIM}tmux reloaded; for the shell:${NC} ${BOLD}exec \$SHELL${NC} (or new pane)\n"
}

cycle() {
    local direction="$1"
    local cur arr idx new
    cur=$(current)
    mapfile -t arr < <(themes)
    idx=-1
    for i in "${!arr[@]}"; do
        [[ "${arr[$i]}" == "$cur" ]] && { idx=$i; break; }
    done
    [[ $idx -lt 0 ]] && idx=0
    if [[ "$direction" == "next" ]]; then
        new="${arr[$(( (idx + 1) % ${#arr[@]} ))]}"
    else
        new="${arr[$(( (idx - 1 + ${#arr[@]}) % ${#arr[@]} ))]}"
    fi
    set_theme "$new"
}

case "${1:-show}" in
    show|status|"")
        printf "${BOLD}${CYAN}▲ active theme:${NC} ${PINK}%s${NC}\n" "$(current)"
        ;;
    list|ls)
        cur=$(current)
        printf "${BOLD}themes:${NC}\n"
        themes | while read -r name; do
            if [[ "$name" == "$cur" ]]; then
                printf "  ${PINK}● ${BOLD}%s${NC}\n" "$name"
            else
                printf "  ${DIM}○${NC} %s\n" "$name"
            fi
        done
        ;;
    set|use)
        if [[ $# -lt 2 ]]; then
            echo "usage: theme set <name>" >&2
            exit 1
        fi
        set_theme "$2"
        ;;
    next|n)        cycle next ;;
    prev|previous|p) cycle prev ;;
    random|rand|r)
        new=$(themes | shuf -n 1)
        set_theme "$new"
        ;;
    -h|--help|help)
        sed -n '2,12p' "$0" | sed 's/^# \?//'
        ;;
    *)
        # Bare name → treat as `theme set <name>`
        set_theme "$1"
        ;;
esac
