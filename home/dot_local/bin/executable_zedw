#!/usr/bin/env bash
# zedw — open paths in the Windows-host Zed (zed.exe) from WSL.
#
# Uses Zed-for-Windows' native WSL remoting (`--wsl user@distro`), so Linux
# paths are passed straight through — no slow \\wsl.localhost translation. This
# is the Zed analogue of the `code` command reaching host VS Code.
#
# Because it's a real executable (not a shell function), it works as $EDITOR /
# $GIT_EDITOR for external tools — pass --wait so the caller blocks.
#
# Reuses the RUNNING Zed window BY DEFAULT (injects --existing), so $EDITOR opens
# never spawn a separate workspace. Force a fresh window with -n/--new.
#
#     export EDITOR="zedw --wait"
#     git commit            # opens COMMIT_EDITMSG in the running Zed window, waits for close
#
# Interactive use:
#     zedw .                open cwd (reuse)  zedw -w notes.md   wait until closed
#     zedw foo.rs bar.rs    open (reuse win)  zedw -n bar.rs     force NEW window
set -euo pipefail

# Locate host zed.exe (first match wins; no hardcoded Windows username).
ZEXE=""
for z in /mnt/c/Users/*/AppData/Local/Programs/Zed/bin/zed.exe \
         "/mnt/c/Program Files/Zed/bin/zed.exe"; do
  [[ -x "$z" ]] && { ZEXE="$z"; break; }
done
if [[ -z "$ZEXE" ]]; then
  echo "zedw: Windows-host Zed (zed.exe) not found under /mnt/c — is Zed installed on Windows?" >&2
  exit 127
fi

distro="${WSL_DISTRO_NAME:-Ubuntu}"
wsluser="${USER:-$(id -un)}"

# No paths → open the current directory.
(( $# )) || set -- .

args=()
for a in "$@"; do
  if [[ "$a" == -* ]]; then
    args+=("$a")                      # flag — pass through (-w/--wait, -e, -n, -a, …)
  elif [[ "$a" == /* ]]; then
    args+=("$a")                      # already absolute
  else
    args+=("$PWD/$a")                 # make cwd-relative paths absolute for Zed
  fi
done

# Default to reusing the running Zed window — Zed otherwise spawns a separate
# workspace per invocation (the annoyance). Opt out with -n/--new (or -a/--add);
# an explicit -e/--existing is honored and not duplicated.
mode=0
for a in "$@"; do case "$a" in -n|--new|-a|--add|-e|--existing) mode=1 ;; esac; done
(( mode )) || args=(--existing "${args[@]}")

exec "$ZEXE" --wsl "${wsluser}@${distro}" "${args[@]}"
