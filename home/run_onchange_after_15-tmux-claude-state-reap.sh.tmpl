#!/usr/bin/env bash
# Reap stale tmux-claude-state instances on every `chezmoi apply` that changes
# the script. Orphaned old-version copies (reparented to PID 1 across a redeploy)
# keep spinning and pile up — once 14 of them pegged 16 cores and spun the GPU
# fans for half an hour. Killing them on apply guarantees the new version starts
# from a clean slate.
#
# Keyed to the script's content hash so chezmoi re-runs this ONLY when the script
# actually changes:
#   hash: {{ include "dot_local/bin/executable_tmux-claude-state" | sha256sum }}
set -u

# Match the DEPLOYED path, not the bare name. This reaper's own path also
# contains the substring "tmux-claude-state", so a bare `pkill -f
# tmux-claude-state` would kill this script mid-run — the exact self-match bug it
# exists to prevent. Anchoring on `.local/bin/` hits only the real instances
# (incl. their `timeout …` wrappers) and never this run-script.
pkill -f '\.local/bin/tmux-claude-state' 2>/dev/null || true
exit 0
