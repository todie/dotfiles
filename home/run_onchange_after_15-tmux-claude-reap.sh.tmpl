#!/usr/bin/env bash
# Reap stale tmux-claude-state / tmux-claude-glanced instances on every `chezmoi
# apply` that changes either script. Orphaned old-version copies (reparented to
# PID 1 across a redeploy) keep spinning and pile up — once 14 of them pegged 16
# cores and spun the GPU fans for half an hour. Killing them on apply guarantees
# the new version (incl. the singleton daemon) starts from a clean slate; the
# tmux session-created/client-attached hooks then respawn the daemon via --ensure.
#
# Keyed to BOTH scripts' content hashes so chezmoi re-runs this when either one
# changes:
#   state:   {{ include "dot_local/bin/executable_tmux-claude-state"   | sha256sum }}
#   glanced: {{ include "dot_local/bin/executable_tmux-claude-glanced" | sha256sum }}
set -u

# Match the DEPLOYED path, not the bare name. This reaper's own path also
# contains "tmux-claude-…", so a bare `pkill -f tmux-claude-glanced` would kill
# this script mid-run — the exact self-match bug it exists to prevent. Anchoring
# on `.local/bin/` hits only the real instances (incl. their `timeout …`
# wrappers) and never this run-script.
pkill -f '\.local/bin/tmux-claude-(state|glanced)' 2>/dev/null || true
exit 0
