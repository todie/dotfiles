{
  "command": "bash",
  "args": [
    "-c",
    "set -a && . $HOME/.secrets && set +a && exec {{ if eq .chezmoi.os "darwin" }}op-mcp{{ else }}{{ .chezmoi.homeDir }}/.local/node/bin/op-mcp{{ end }}"
  ],
  "env": {
    "OP_PATH": "{{ if eq .chezmoi.os "darwin" }}/opt/homebrew/bin/op{{ else }}{{ .chezmoi.homeDir }}/.local/bin/op{{ end }}"
  }
}
