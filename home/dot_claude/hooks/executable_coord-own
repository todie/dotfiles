#!/usr/bin/env bash
# coord-own — claim / release ownership of a coord resource in the ownership
# manifest read by guard-coord-ownership.sh. Identifies THIS pane via /proc
# ancestry → claude-pid-<pid> (same scheme as coord session ids).
#
# Usage:
#   coord-own <resource> [--reason "…"] [--ttl MINUTES]   # claim (default ttl 120m)
#   coord-own <resource> --release                        # release (only if you own it)
#   coord-own --show                                       # print the manifest
#
# Pairs with guard-coord-ownership.sh: the hook BLOCKS guarded ops (merge-to-main)
# from any pane that isn't the declared owner. Inert until something is claimed.
set -uo pipefail
MANIFEST="${COORD_OWNERSHIP_MANIFEST:-/tmp/claude-coord/ownership.json}"
mkdir -p "$(dirname "$MANIFEST")" 2>/dev/null || true
command -v jq >/dev/null 2>&1 || { echo "coord-own: jq required" >&2; exit 1; }

me_pane() {
  local pid=$PPID c np
  for _ in $(seq 1 14); do
    [ -r "/proc/$pid/comm" ] || break
    c=$(cat "/proc/$pid/comm" 2>/dev/null || echo)
    case "$c" in claude|claude-code) echo "claude-pid-$pid"; return ;; esac
    np=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo)
    { [ -n "$np" ] && [ "$np" != "0" ] && [ "$np" != "$pid" ]; } || break
    pid=$np
  done
  echo "claude-pid-$PPID"   # best-effort fallback
}

[ "${1:-}" = "--show" ] && { [ -f "$MANIFEST" ] && jq . "$MANIFEST" || echo '{"resources":{}}'; exit 0; }
res="${1:-}"; [ -z "$res" ] && { echo "usage: coord-own <resource> [--reason …] [--ttl MIN] | --release | --show" >&2; exit 1; }
shift || true
release=0; ttl=120; reason=""
while [ $# -gt 0 ]; do
  case "$1" in
    --release) release=1 ;;
    --ttl) shift; ttl="${1:-120}" ;;
    --reason) shift; reason="${1:-}" ;;
    *) echo "coord-own: unknown arg $1" >&2; exit 1 ;;
  esac; shift || true
done

me=$(me_pane)
[ -f "$MANIFEST" ] || echo '{"version":1,"resources":{}}' > "$MANIFEST"
now=$(date +%s); until=$(( now + ttl*60 ))

if [ "$release" = 1 ]; then
  jq --arg r "$res" --arg me "$me" 'if (.resources[$r].owner // "") == $me then del(.resources[$r]) else . end' \
     "$MANIFEST" > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
  echo "coord-own: released '$res' (if owned by $me)"
else
  cur=$(jq -r --arg r "$res" --argjson now "$now" '.resources[$r] // empty | select((.ttl_until // 9999999999) > $now) | .owner // empty' "$MANIFEST" 2>/dev/null)
  if [ -n "$cur" ] && [ "$cur" != "$me" ]; then
    echo "coord-own: '$res' already owned by $cur (not me=$me). Refusing to steal; coordinate or --release on the owner." >&2
    exit 2
  fi
  jq --arg r "$res" --arg me "$me" --argjson u "$until" --arg rs "$reason" \
     '.resources[$r] = {owner:$me, ttl_until:$u, reason:$rs}' \
     "$MANIFEST" > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
  echo "coord-own: claimed '$res' for $me (ttl ${ttl}m, until $(date -d @"$until" 2>/dev/null || echo $until))"
fi
