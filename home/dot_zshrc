# ${HOME}/.zshrc: user profile for zsh (zsh(1))
# Author: Christian M. Todie <chris@todie.io>

export GPG_TTY=$TTY
export DOTFILES_ZSH_DEBUG="${DOTFILES_ZSH_DEBUG:-0}"
export DOTFILES_ZSH_CACHE=${XDG_CACHE_HOME:-~/.cache}/zsh

# Completion fpath must be set BEFORE compinit so cached _tool files autoload.
fpath=("$HOME/.zsh/completions" $fpath)

# Daily-cached compinit. Rebuilding the dump (compaudit + compdump) costs
# ~200ms and runs on EVERY start by default. Instead: regenerate at most once
# per 24h; otherwise load the existing dump with -C (skips the security audit).
# Shared dump path ($ZCOMPDUMP) is reused by completions.zsh's regen.
export ZCOMPDUMP="${DOTFILES_ZSH_CACHE}/.zcompdump"
[[ -d $DOTFILES_ZSH_CACHE ]] || mkdir -p "$DOTFILES_ZSH_CACHE"
autoload -U +X compinit
() {
  setopt local_options extended_glob
  if [[ -n $ZCOMPDUMP(#qNmh-24) ]]; then
    compinit -C -d "$ZCOMPDUMP"      # fresh dump (<24h) — trust it, skip audit
  else
    compinit -u -d "$ZCOMPDUMP"      # stale/missing — full rebuild
  fi
}

# ~w => Windows home on WSL
[[ -z $dotfiles_win_home ]] || hash -d w=$dotfiles_win_home

# Under the chezmoi copy model, ~/.zshrc is a real file (not a symlink), so the
# %x self-resolution trick would yield $HOME and break lib loading. Use a static
# literal path to the deployed lib dir (~/.config/zsh, from dot_config/zsh).
DOTFILES_ZSH_DIR="$HOME/.config/zsh"

# mise — machine tool manager. Activate BEFORE loading the lib modules so the
# tool-inits inside them (env.zsh runs `starship init`, direnv hook, …) can
# resolve mise-managed binaries. mise prepends its shim dir; env.zsh's later
# path+= only appends, so mise keeps PATH precedence. Manifest:
# ~/.config/mise/config.toml — see docs/tooling-strategy.md.
# sshd spawns zsh with the bare system PATH, and ~/.local/bin (where mise
# lives) is only appended later in env.zsh — after this gate. Prepend it here
# so SSH logins activate mise too; env.zsh's typeset -U dedups the re-append.
path=("$HOME/.local/bin" $path)
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# Load modules in dependency order.
for _module in \
  $DOTFILES_ZSH_DIR/lib/functions.zsh \
  $DOTFILES_ZSH_DIR/lib/env.zsh \
  $DOTFILES_ZSH_DIR/lib/options.zsh \
  $DOTFILES_ZSH_DIR/lib/plugins.zsh \
  $DOTFILES_ZSH_DIR/lib/completions.zsh \
  $DOTFILES_ZSH_DIR/lib/aliases.zsh \
  $DOTFILES_ZSH_DIR/lib/claude.zsh \
  $DOTFILES_ZSH_DIR/lib/tmux.zsh \
  $DOTFILES_ZSH_DIR/lib/secrets.zsh; do
  [[ -r $_module ]] && source "$_module"
done
unset _module

# coreweave dev-shell integration.
[[ -r /usr/local/share/dev-shell/dev-shell ]] && source /usr/local/share/dev-shell/dev-shell

# User-local overrides — not tracked in dotfiles.
[[ -f "${HOME}/.zshrc-${USER}" ]] && source "${HOME}/.zshrc-${USER}"


# --- ssh-agent ---
# Removed: SSH now routed through 1Password via ~/.zshrc-ctodie (aliases
# ssh/ssh-add to ssh.exe/ssh-add.exe per WSL integration docs).

# Prefer stored gh OAuth token over inherited GITHUB_TOKEN PAT (which lacks SSO access to cerebral-work/*)
gh() { GH_TOKEN= GITHUB_TOKEN= GH_ENTERPRISE_TOKEN= command gh "$@"; }

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# claude yolo (sandboxed/throwaway dirs only)
alias cy="claude --dangerously-skip-permissions"

# terraform shell completion (terraform now resolves via the mise shim / PATH,
# not a hardcoded ~/.local/bin path). bashcompinit is set up in lib/env.zsh.
command -v terraform >/dev/null 2>&1 && complete -o nospace -C "$(command -v terraform)" terraform

# opencode
export PATH=$HOME/.opencode/bin:$PATH

# OpenBao (unsigned-paas-dev, via tailnet LB — bao.dev.unsigned.gg ingress is dead)
export BAO_ADDR=http://bao.tail769bd2.ts.net

# Installer-appended blocks below. These landed via installers run on ceres
# (Linux); the paths do not exist on macOS hosts, and an unguarded `source` of
# a missing file errors on every shell start. Guard each — a no-op where the
# file is absent, unchanged behaviour where it is present.

# >>> railway initialize >>>
[ -f "$HOME/.railway/env" ] && source "$HOME/.railway/env"
# <<< railway initialize <<<

[ -f "$HOME/.moon/bin/env" ] && . "$HOME/.moon/bin/env"

# Added by biomni setup
# Remove any old paths first to avoid duplicates
BIOMNI_BIN="$HOME/projects/cerebral/biomni/biomni_env/biomni_tools/bin"
if [ -d "$BIOMNI_BIN" ]; then
  PATH=$(echo $PATH | tr ':' '\n' | grep -v "biomni_tools/bin" | tr '\n' ':' | sed 's/:$//')
  export PATH="$BIOMNI_BIN:$PATH"
fi
unset BIOMNI_BIN
