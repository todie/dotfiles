# .chezmoiignore — paths chezmoi must NOT manage/apply to $HOME.
# Patterns are matched against the TARGET path (relative to $HOME), one per line.
#
# Two classes are ignored here:
#   1. Theme SOURCE tomls — they live in the source tree as raw input
#      (home/starship/base.toml, home/starship/themes/*.toml) and are read at
#      runtime by ~/.local/bin/theme via {{ .chezmoi.sourceDir }}/starship/.
#      They must never be copied into $HOME.
#   2. GENERATED artifacts — emitted at apply time (run_onchange theme script)
#      or at shell runtime. chezmoi must not try to own or diff them.

# ── 1. theme source tomls (source-input, read from the source tree) ──────────
starship
starship/base.toml
starship/themes
starship/themes/*.toml

# ── 2. generated by the theme run_onchange script (`theme set`) ──────────────
.config/starship.toml
.config/starship.theme
.config/tmux/theme.conf
.config/zsh/theme.zsh

# ── runtime-generated zsh completions (unmanaged; self-heal on first shell) ──
# NOTE: ~/.local/share/zsh/completions/_claude IS managed — do NOT ignore it.
.zsh/completions
.zsh/completions/*

# ── runtime-generated secrets cache (legacy; superseded by rendered .env) ────
.cache/zsh-secrets.env

# ── operator-managed (chezmoi does NOT own ~/.secrets — token bootstrap) ─────
# ~/.secrets holds OP_SERVICE_ACCOUNT_TOKEN and is managed by hand; the app keys
# it used to also hold are rendered to ~/.config/zsh/secrets.env at apply time.
.secrets
