# .chezmoiignore — paths chezmoi must NOT manage/apply to $HOME.
# Patterns are matched against the TARGET path (relative to $HOME), one per line.
#
# Two classes are ignored here:
#   1. Theme SOURCE tomls — they live in the source tree as raw input
#      (home/starship/base.toml, home/starship/themes/*.toml) and are read at
#      runtime by ~/.local/bin/theme via {{ .chezmoi.sourceDir }}/starship/.
#      They must never be copied into $HOME.
#   2. GENERATED artifacts — emitted at apply time (run_onchange theme script)
#      or at shell runtime. chezmoi must not try to own or diff them.

# ── 1. theme source tomls (source-input, read from the source tree) ──────────
starship
starship/base.toml
starship/themes
starship/themes/*.toml

# ── 2. generated by the theme run_onchange script (`theme set`) ──────────────
.config/starship.toml
.config/starship.theme
.config/tmux/theme.conf
.config/zsh/theme.zsh

# ── runtime-generated zsh completions (unmanaged; self-heal on first shell) ──
# NOTE: ~/.local/share/zsh/completions/_claude IS managed — do NOT ignore it.
.zsh/completions
.zsh/completions/*

# ── runtime-generated secrets cache (legacy; superseded by rendered .env) ────
.cache/zsh-secrets.env

# ── operator-managed (chezmoi does NOT own ~/.secrets — token bootstrap) ─────
# ~/.secrets holds OP_SERVICE_ACCOUNT_TOKEN and is managed by hand; the app keys
# it used to also hold are rendered to ~/.config/zsh/secrets.env at apply time.
.secrets

# ── ~/.claude — persist CONFIG only (CLAUDE.md, RTK.md, rules, hooks, skills,
#    agents, mcp). Everything below is state/secret/external and must NOT be
#    managed. See docs/tooling-strategy.md / the persist plan. ────────────────
# settings.json: committed ONCE as a recovery snapshot, then ignored — Claude
# Code rewrites it, so chezmoi must not fight it (operator chose commit-once).
.claude/settings.json
.claude/settings.local.json
.claude/settings.json.bak*
# secrets / auth — never manage.
.claude/.credentials.json
.claude/.claude.json
# reverie-owned (built/installed from the reverie repo, like ~/.claude/bin).
.claude/bin
# external-pointing skill symlinks live in ~/.agents (out of scope here).
.claude/skills/coord-drain
.claude/skills/cut-release
.claude/skills/file-bug
.claude/skills/linear-file-spec
.claude/skills/mesh-cleanup
.claude/skills/orphan-lock-clean
.claude/skills/reveried-swap
.claude/skills/snapshot
.claude/skills-disabled
# generated hook artifact.
.claude/hooks/.rtk-hook.sha256
# huge machine-state — never manage.
.claude/plugins
.claude/projects
.claude/context-mode
.claude/file-history
.claude/history.jsonl
.claude/shell-snapshots
.claude/session-env
.claude/backups
.claude/cache
.claude/usage-data
.claude/tasks
.claude/sessions
.claude/logs
.claude/jobs
.claude/plans
.claude/paste-cache
.claude/daemon
.claude/daemon.log
.claude/coord
.claude/ide
.claude/downloads
.claude/stats-cache.json
.claude/mcp-needs-auth-cache.json
