{{- /* ~/.secrets — bootstrap secrets for headless `op`, 0600 (private_).
        Sourced (set -a) by lib/secrets.zsh and the op-mcp wrapper.

        IMPORTANT BOOTSTRAP CONSTRAINT:
        OP_SERVICE_ACCOUNT_TOKEN is the credential that authorizes
        `onepasswordRead`/`op` itself, so it CANNOT be rendered via
        onepasswordRead (chicken-and-egg). [onepassword] mode="service" reads it
        from the apply-time ENVIRONMENT (OP_SERVICE_ACCOUNT_TOKEN must be
        exported before `chezmoi apply` runs). We persist it here for subsequent
        interactive shells by echoing the env value through chezmoi's env access.

        If the token is NOT in the apply-time env, this renders an empty value
        and you must populate ~/.secrets out-of-band (the symlink setup never
        managed this file either — see manifest .zshenv/secrets divergence). */ -}}
# Managed by chezmoi — do not edit. 0600. Bootstrap token for headless 1Password.
{{ if env "OP_SERVICE_ACCOUNT_TOKEN" -}}
export OP_SERVICE_ACCOUNT_TOKEN={{ env "OP_SERVICE_ACCOUNT_TOKEN" | quote }}
{{- else -}}
{{ fail "OP_SERVICE_ACCOUNT_TOKEN not set in apply-time environment; refusing to render an empty ~/.secrets bootstrap token" }}
{{- end }}
