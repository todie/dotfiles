# Pinned external artifacts — chezmoi-native fetch with sha256 verification.
# Doctrine: pin-everything. refreshPeriod=0 → only re-fetched when this file
# changes (version bump = edit here, checksums from the release's checksums.txt).
#
# Deliberately NOT here:
#   - zsh plugins: plugins.zsh owns clone+update at runtime (self-heal is a
#     feature — works without chezmoi); externals would create dual ownership.
#   - mise/krew-managed tools: those layers own their own pinning.
# kubecolor is here because it has no mise/aqua registry entry.

{{ $kubecolorVer := "0.6.0" -}}
{{/* Checksums from the release's checksums.txt, keyed os_arch. The OS must be
     templated too — a linux-only URL silently installs an ELF on darwin, which
     fails at exec time (europa, 2026-07-27). */ -}}
{{ $kubecolorSums := dict
     "linux_amd64"  "ded167eb2d94145cc46e4ccb52db24e85a865858353014514a85cb59c649d2fe"
     "linux_arm64"  "aa56015817bdfe8a8944169e5b18108235fb5bca671f89fa52613b4379bf1f66"
     "darwin_amd64" "8edea5adc6bdb121ec907014790ca780c97aac3766e0c27327227ccc0748c7e4"
     "darwin_arm64" "22f08853f8925613f1792dd5acaaf0661284bb647d69ff50ad9552027b0d456a" -}}
{{ $kubecolorPlat := printf "%s_%s" .chezmoi.os .chezmoi.arch -}}
{{ $kubecolorSha := get $kubecolorSums $kubecolorPlat -}}

[".local/bin/kubecolor"]
    type = "archive-file"
    url = "https://github.com/kubecolor/kubecolor/releases/download/v{{ $kubecolorVer }}/kubecolor_{{ $kubecolorVer }}_{{ $kubecolorPlat }}.tar.gz"
    path = "kubecolor"
    executable = true
    checksum.sha256 = "{{ $kubecolorSha }}"
    refreshPeriod = "0"

{{ if eq .chezmoi.os "linux" -}}
{{ $butRelease := "0.22.3-3234" -}}
{{ $butArch := "x86_64" -}}
{{ $butSha := "3f4f543a6ccd931ce6c86c484058dbe5e29439597d001f6a0a9c28d9e533ea18" -}}
{{ if eq .chezmoi.arch "arm64" -}}
{{ $butArch = "aarch64" -}}
{{ $butSha = "315a0be79e21c66cd72785ee4775ead19daaa992a1b22c49022060fe89581eeb" -}}
{{ end -}}

[".local/bin/but"]
    type = "file"
    url = "https://releases.gitbutler.com/releases/release/{{ $butRelease }}/linux/{{ $butArch }}/but"
    executable = true
    checksum.sha256 = "{{ $butSha }}"
    refreshPeriod = "0"
{{ end -}}

