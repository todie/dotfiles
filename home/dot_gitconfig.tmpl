[user]
	email = {{ .identity.email }}
	name = {{ .identity.name }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	pager = delta
	autocrlf = input
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
{{- /* zdiff3 needs git 2.35+. Older git (Ubuntu 22.04 ships 2.34) rejects the
       unknown style and then fails every command, so fall back to diff3 there.
       `git --version` does not read this file, so it works even when it is broken. */}}
{{- $gitVersion := "0.0.0" }}
{{- if lookPath "git" }}
{{-   $gitVersion = output "git" "--version" | regexFind "[0-9]+\\.[0-9]+(\\.[0-9]+)?" | default "0.0.0" }}
{{- end }}
[merge]
	conflictStyle = {{ if semverCompare ">=2.35.0" $gitVersion }}zdiff3{{ else }}diff3{{ end }}
[alias]
	st = status -sb
	co = checkout
	sw = switch
	lg = log --oneline --graph --decorate -20
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	wt = worktree
	last = log -1 HEAD --stat
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedsignersfile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[credential "https://github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
