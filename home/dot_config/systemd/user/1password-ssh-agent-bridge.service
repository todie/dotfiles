[Unit]
Description=Bridge the Windows 1Password SSH agent pipe to ~/.1password/agent.sock (socat + npiperelay)
Documentation=https://developer.1password.com/docs/ssh/agent/
After=default.target

[Service]
Type=simple
Environment=NPIPERELAY=/mnt/c/Users/chris/AppData/Local/npiperelay/npiperelay.exe
ExecStartPre=/usr/bin/mkdir -p %h/.1password
ExecStartPre=-/usr/bin/rm -f %h/.1password/agent.sock
ExecStart=/usr/bin/socat UNIX-LISTEN:%h/.1password/agent.sock,fork,mode=600,unlink-early EXEC:"${NPIPERELAY} -ei -s //./pipe/openssh-ssh-agent",nofork
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
