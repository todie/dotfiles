{{- /* ~/.config/zsh/secrets.env — rendered from 1Password at apply time.
        0600 (private_ filename prefix). Sourced by lib/secrets.zsh.
        Replaces the runtime `op read` + daily-cache machinery.
        Refs are resolved via onepasswordRead; [onepassword] mode="service"
        reads OP_SERVICE_ACCOUNT_TOKEN from the apply-time environment. */ -}}
# Managed by chezmoi — do not edit. Rendered from op:// refs at `chezmoi apply`.
{{- if env "OP_SERVICE_ACCOUNT_TOKEN" }}
export GITHUB_PERSONAL_ACCESS_TOKEN={{ onepasswordRead "op://cloud/xeyhu6cuy4m7aiizwypkxvl5bq/token" | quote }}
export GITHUB_CEREBRAL_TOKEN={{ onepasswordRead "op://cloud/w2qcdty2ei5oc2sudwfe74yiwe/credential" | quote }}
export LINEAR_API_KEY={{ onepasswordRead "op://cloud/cerebral-linear-api/credential" | quote }}
export ANTHROPIC_API_KEY={{ onepasswordRead "op://cloud/cerebral-anthropic-api/credential" | quote }}
export OPENROUTER_API_KEY={{ onepasswordRead "op://cloud/cerebral-openrouter-api/credential" | quote }}
export UNSIGNED_LLM_API_KEY={{ onepasswordRead "op://cloud/unsigned-llm/credential" | quote }}
export MERMAID_TOKEN={{ onepasswordRead "op://cloud/mermaid/credential" | quote }}
{{- else }}
# OP_SERVICE_ACCOUNT_TOKEN was not set at `chezmoi apply` time, so the op://
# refs were NOT resolved and no keys are exported here. This is intentional:
# a missing token must not abort the whole apply. Provide the token (source
# ~/.secrets, or `export OP_SERVICE_ACCOUNT_TOKEN=...`) and re-run
# `chezmoi apply` to populate. App keys are optional for a usable shell.
{{- end }}
