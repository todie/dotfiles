{{- /* ~/.config/zsh/secrets.env — rendered from 1Password at apply time.
        0600 (private_ filename prefix). Sourced by lib/secrets.zsh.
        Replaces the runtime `op read` + daily-cache machinery.
        Refs are resolved via onepasswordRead; [onepassword] mode="service"
        reads OP_SERVICE_ACCOUNT_TOKEN from the apply-time environment. */ -}}
# Managed by chezmoi — do not edit. Rendered from op:// refs at `chezmoi apply`.
{{- /* API keys are OPTIONAL and DEFAULT OFF (2026-08-23). Nothing below renders
        unless this machine opts in via ~/.config/chezmoi/chezmoi.toml:
          [data.secrets]
          apiKeys = true           # cloud-tier keys (op://cloud/*)
          workstationKeys = true   # + workstation-tier keys (op://workstation-keys/*)
        AND OP_SERVICE_ACCOUNT_TOKEN is exported at apply time. A missing flag or
        token must never abort `chezmoi apply`. Defaults live in .chezmoidata.toml. */ -}}
{{- $apiKeys := dig "secrets" "apiKeys" false . }}
{{- $wsKeys := dig "secrets" "workstationKeys" false . }}
{{- if and $apiKeys (env "OP_SERVICE_ACCOUNT_TOKEN") }}
# GITHUB_PERSONAL_ACCESS_TOKEN and GITHUB_CEREBRAL_TOKEN removed 2026-08-04.
# Both were dead weight — nothing on either host consumed them (only this
# template defined them), and both failed auth:
#   * the personal PAT (op://cloud/personal-github-personal-access-token) was
#     EXPIRED — 401 against api.github.com. Archived.
#   * GITHUB_CEREBRAL_TOKEN was MIS-WIRED: it read
#     op://cloud/cerebral-cloudflare-r2-api-token-DEDUP-REVIEW, a Cloudflare R2
#     credential, so of course it 401'd against GitHub. That item is left alone
#     in 1Password — it is a real R2 token, just not a GitHub one.
# `gh` carries its own OAuth token and git uses SSH, so neither is needed in the
# ambient environment. If a PAT is wanted again, mint a fresh one — do not point
# these at op://cloud/cerebral-github-mirroring-pat (the only GitHub credential
# in the vault that still authenticates), which is scoped for mirroring.
export LINEAR_API_KEY={{ onepasswordRead "op://cloud/cerebral-linear-api/credential" | quote }}
# The Anthropic API key is deliberately NOT rendered here, under any name.
#
# ANTHROPIC_API_KEY takes precedence over the claude.ai subscription login in
# the claude CLI (and disables its connectors), and that key's account has no
# credit — so an ambient export makes `claude` fail with "Credit balance is too
# low" while the subscription works fine. Verified 2026-07-27:
# `env -u ANTHROPIC_API_KEY claude -p ...` succeeds where the bare command
# fails. It also explains a subtler symptom: a launchd agent running claude
# SUCCEEDED where an interactive shell failed, purely because the agent did not
# inherit the variable.
#
# It was previously rendered as ANTHROPIC_API_KEY_INACTIVE, which kept it out of
# the precedence path but still put the secret in every process's environment.
# Now nothing is exported: `anthropic-api <cmd>` (lib/claude.zsh) reads
# op://cloud/cerebral-anthropic-api/credential at call time for the few tools
# that genuinely want API billing (e.g. `ant`).
export OPENROUTER_API_KEY={{ onepasswordRead "op://cloud/cerebral-openrouter-api/credential" | quote }}
export UNSIGNED_LLM_API_KEY={{ onepasswordRead "op://cloud/unsigned-llm/credential" | quote }}
# Per-workspace gateway keys (unsigned-paas PR #1016; llm chart 0.4.3). The
# chpwd hook in lib/functions.zsh swaps UNSIGNED_LLM_API_KEY to the matching
# ws-* key inside each estate; the shared key above is the fallback.
export UNSIGNED_LLM_KEY_WS_PAAS={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-paas" | quote }}
export UNSIGNED_LLM_KEY_WS_MISSION_CONTROL={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-mission-control" | quote }}
export UNSIGNED_LLM_KEY_WS_GG={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-gg" | quote }}
export UNSIGNED_LLM_KEY_WS_CEREBRAL_HQ={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-cerebral-hq" | quote }}
export UNSIGNED_LLM_KEY_WS_REVERIE={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-reverie" | quote }}
export UNSIGNED_LLM_KEY_WS_USEWIRE={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-usewire" | quote }}
export UNSIGNED_LLM_KEY_WS_TERRARIUM={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-terrarium" | quote }}
export UNSIGNED_LLM_KEY_WS_CEREBRAL_DESIGN={{ onepasswordRead "op://cloud/unsigned-llm-extra-keys/ws-cerebral-design" | quote }}
export MERMAID_TOKEN={{ onepasswordRead "op://cloud/mermaid/credential" | quote }}
export NEURALWATT_API_KEY={{ onepasswordRead "op://cloud/unsigned-neuralwatt/credential" | quote }}
export CRUSOE_API_KEY={{ onepasswordRead "op://cloud/cerebral-crusoe-inference-api/credential" | quote }}
export ATTIO_API_KEY={{ onepasswordRead "op://cloud/attio-ctodie-godmode/credential" | quote }}
{{- if $wsKeys }}
# Workstation-tier keys (op://workstation-keys/*) — reachable ONLY by the
# workstation-apply service account deployed to Europa/Ceres ~/.secrets, never by
# cloud-provisioned service accounts (which hold a cloud-only token). Keeps
# personal app keys out of any cloud-readable scope. Gated separately
# (secrets.workstationKeys) because a cloud-only token cannot resolve these and
# would otherwise fail the whole apply.
export MOONSHOT_API_KEY={{ onepasswordRead "op://workstation-keys/kimi3 api/credential" | quote }}
export KIMI_API_KEY={{ onepasswordRead "op://workstation-keys/kimi3 api/credential" | quote }}
{{- else }}
# workstation-tier keys (MOONSHOT/KIMI) not rendered: secrets.workstationKeys is off.
{{- end }}
{{- else }}
# API keys not rendered — this is the DEFAULT. Either secrets.apiKeys is off for
# this machine, or OP_SERVICE_ACCOUNT_TOKEN was not set at `chezmoi apply` time.
# Opt in: set [data.secrets] apiKeys = true in ~/.config/chezmoi/chezmoi.toml,
# export the token (source ~/.secrets), re-run `chezmoi apply`.
# App keys are optional for a usable shell.
{{- end }}
